# Google Cloud Console OAuth 2.0 Client ID
# Create one at https://console.cloud.google.com/apis/credentials
# Make sure to add http://localhost:8080 to "Authorized JavaScript origins"
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Formspark form ID for the Contact Us page
# Create a form at https://formspark.io and paste the form ID here
VITE_FORMSPARK_FORM_ID=your-formspark-form-id

# Google Gemini API key
VITE_GEMINI_API_KEY=your-gemini-api-key-here